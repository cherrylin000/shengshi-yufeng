{
  "language": "zh",
  "duration": 2835.04175,
  "segments": [
    {
      "start": 2.32,
      "end": 10.38,
      "text": "第一天就在地上的地上"
    },
    {
      "start": 10.38,
      "end": 101.49,
      "text": "就有寫个博物"
    },
    {
      "start": 101.49,
      "end": 113.22,
      "text": "第二就是因为今天有个大跌"
    },
    {
      "start": 113.22,
      "end": 118.74,
      "text": "第一种"
    },
    {
      "start": 118.74,
      "end": 162.34,
      "text": "第一天的古苗"
    },
    {
      "start": 162.34,
      "end": 249.26,
      "text": "我从或者是两年这样的长的视影团"
    },
    {
      "start": 249.26,
      "end": 255.51,
      "text": "我们应对的办法"
    },
    {
      "start": 255.51,
      "end": 263.69,
      "text": "那不知道要好经济"
    },
    {
      "start": 263.69,
      "end": 285.76,
      "text": "肯定是要想"
    },
    {
      "start": 285.76,
      "end": 290.12,
      "text": "也没用过好自己的小日子"
    },
    {
      "start": 290.12,
      "end": 291.76,
      "text": "再次集家里"
    },
    {
      "start": 291.76,
      "end": 298.54,
      "text": "但不该想"
    },
    {
      "start": 298.54,
      "end": 303.82,
      "text": "点了一篇博物"
    },
    {
      "start": 303.82,
      "end": 316.19,
      "text": "多提到一个东西"
    },
    {
      "start": 316.19,
      "end": 317.95,
      "text": "我提了这样一个目标"
    },
    {
      "start": 317.95,
      "end": 321.58,
      "text": "分解开来"
    },
    {
      "start": 321.58,
      "end": 326.82,
      "text": "就是一次要一年一样"
    },
    {
      "start": 326.82,
      "end": 329.84,
      "text": "二十次"
    },
    {
      "start": 329.84,
      "end": 337.8,
      "text": "或者二十年"
    },
    {
      "start": 337.8,
      "end": 356.02,
      "text": "你才能一个东西"
    },
    {
      "start": 356.02,
      "end": 367.01,
      "text": "尝奇投资的东西"
    },
    {
      "start": 367.01,
      "end": 382.16,
      "text": "就是时间光掉"
    },
    {
      "start": 382.16,
      "end": 383.28,
      "text": "所以"
    },
    {
      "start": 383.28,
      "end": 386.61,
      "text": "这个时间光掉"
    },
    {
      "start": 386.61,
      "end": 391.46,
      "text": "身上这也仅仅是"
    },
    {
      "start": 391.46,
      "end": 392.5,
      "text": "我的一个说法"
    },
    {
      "start": 392.5,
      "end": 399.73,
      "text": "对真正来讲"
    },
    {
      "start": 399.73,
      "end": 427.23,
      "text": "进程"
    },
    {
      "start": 427.23,
      "end": 431.71,
      "text": "应在最近的几篇博物"
    },
    {
      "start": 431.71,
      "end": 434.58,
      "text": "能到个附福里"
    },
    {
      "start": 434.58,
      "end": 439.26,
      "text": "能在通过通常率"
    },
    {
      "start": 439.34,
      "end": 447.23,
      "text": "实际的通过不明醒"
    },
    {
      "start": 447.23,
      "end": 461.93,
      "text": "但感觉的低频的增长率"
    },
    {
      "start": 461.93,
      "end": 473.69,
      "text": "就是"
    },
    {
      "start": 473.69,
      "end": 492.2,
      "text": "也就是货币类的"
    },
    {
      "start": 492.2,
      "end": 508.61,
      "text": "你是上的"
    },
    {
      "start": 508.61,
      "end": 522.51,
      "text": "你就能用"
    },
    {
      "start": 522.51,
      "end": 523.75,
      "text": "你基本能区调"
    },
    {
      "start": 523.75,
      "end": 549.5,
      "text": "七成多"
    },
    {
      "start": 549.5,
      "end": 550.38,
      "text": "一天万"
    },
    {
      "start": 550.38,
      "end": 552.17,
      "text": "另外"
    },
    {
      "start": 552.17,
      "end": 553.37,
      "text": "一里"
    },
    {
      "start": 553.37,
      "end": 561.9,
      "text": "你未来的问题就来"
    },
    {
      "start": 561.9,
      "end": 578.43,
      "text": "就是我给大家的解决"
    },
    {
      "start": 578.43,
      "end": 578.79,
      "text": "好"
    },
    {
      "start": 578.79,
      "end": 600.6,
      "text": "一场的解单"
    },
    {
      "start": 600.6,
      "end": 602.52,
      "text": "因为我还要加上"
    },
    {
      "start": 602.52,
      "end": 603.88,
      "text": "古苗里百树"
    },
    {
      "start": 603.88,
      "end": 604.76,
      "text": "那就更好"
    },
    {
      "start": 604.76,
      "end": 611.82,
      "text": "负力上将"
    },
    {
      "start": 611.82,
      "end": 614.37,
      "text": "大致"
    },
    {
      "start": 614.37,
      "end": 624.32,
      "text": "鱼说一"
    },
    {
      "start": 624.32,
      "end": 625.04,
      "text": "你别看这个"
    },
    {
      "start": 642.03,
      "end": 643.11,
      "text": "你二十年"
    },
    {
      "start": 643.11,
      "end": 645.95,
      "text": "大概就十二十三倍"
    },
    {
      "start": 645.95,
      "end": 647.83,
      "text": "多一点点"
    },
    {
      "start": 647.83,
      "end": 649.91,
      "text": "你成一这个二点六"
    },
    {
      "start": 649.91,
      "end": 651.99,
      "text": "那就是五十倍了"
    },
    {
      "start": 651.99,
      "end": 653.91,
      "text": "你有没有这个事没有"
    },
    {
      "start": 653.91,
      "end": 659.14,
      "text": "你对岳十三倍"
    },
    {
      "start": 659.14,
      "end": 664.76,
      "text": "很奇怪"
    },
    {
      "start": 664.76,
      "end": 673.26,
      "text": "这个本事上讲"
    },
    {
      "start": 673.26,
      "end": 674.54,
      "text": "你空手套外"
    },
    {
      "start": 674.54,
      "end": 694.18,
      "text": "他们又要你买"
    },
    {
      "start": 694.18,
      "end": 711.84,
      "text": "请别我说的那就是期"
    },
    {
      "start": 711.84,
      "end": 713.48,
      "text": "那是期"
    },
    {
      "start": 713.48,
      "end": 716.92,
      "text": "你是让怎么了个二十三倍"
    },
    {
      "start": 716.92,
      "end": 725.98,
      "text": "但是你多的这个"
    },
    {
      "start": 725.98,
      "end": 727.38,
      "text": "你就"
    },
    {
      "start": 727.38,
      "end": 736.33,
      "text": "把几就跟他们通过"
    },
    {
      "start": 736.33,
      "end": 749.57,
      "text": "不动力上做投资"
    },
    {
      "start": 749.57,
      "end": 754.75,
      "text": "是个东西"
    },
    {
      "start": 754.75,
      "end": 780.04,
      "text": "是上有很多人"
    },
    {
      "start": 780.04,
      "end": 781.16,
      "text": "他有的人"
    },
    {
      "start": 781.16,
      "end": 795.07,
      "text": "他根本就没有通通"
    },
    {
      "start": 795.07,
      "end": 796.27,
      "text": "我经常跟大家讲"
    },
    {
      "start": 796.27,
      "end": 797.51,
      "text": "我说这个"
    },
    {
      "start": 797.51,
      "end": 804.62,
      "text": "什么最重要"
    },
    {
      "start": 804.62,
      "end": 808.8,
      "text": "他市场"
    },
    {
      "start": 808.8,
      "end": 811.16,
      "text": "有的人那个观念是什么呢"
    },
    {
      "start": 811.16,
      "end": 812.52,
      "text": "他就印着票"
    },
    {
      "start": 812.52,
      "end": 820.12,
      "text": "就不印这个古车"
    },
    {
      "start": 820.12,
      "end": 823.84,
      "text": "就在那个东西有用吗"
    },
    {
      "start": 823.84,
      "end": 824.4,
      "text": "市场"
    },
    {
      "start": 824.4,
      "end": 826.44,
      "text": "他这就是一个非常大的"
    },
    {
      "start": 826.44,
      "end": 844.93,
      "text": "物家内解开"
    },
    {
      "start": 844.93,
      "end": 875.28,
      "text": "你从林郑郑当来快起来"
    },
    {
      "start": 875.28,
      "end": 877.44,
      "text": "我去了右下来"
    },
    {
      "start": 877.44,
      "end": 878.12,
      "text": "然后呢"
    },
    {
      "start": 878.12,
      "end": 885.4,
      "text": "林郑讲吧"
    },
    {
      "start": 885.4,
      "end": 887.48,
      "text": "你要是真的把这个"
    },
    {
      "start": 887.48,
      "end": 905.75,
      "text": "背所"
    },
    {
      "start": 905.75,
      "end": 907.07,
      "text": "你就吃有古车"
    },
    {
      "start": 907.07,
      "end": 914.13,
      "text": "你就给自己定一个"
    },
    {
      "start": 914.13,
      "end": 928.08,
      "text": "某一天"
    },
    {
      "start": 928.08,
      "end": 930.44,
      "text": "你就是"
    },
    {
      "start": 930.44,
      "end": 931.4,
      "text": "当这个古票"
    },
    {
      "start": 931.4,
      "end": 933.84,
      "text": "一到那个点上的时候"
    },
    {
      "start": 933.84,
      "end": 935.64,
      "text": "你就给自己"
    },
    {
      "start": 935.64,
      "end": 958.49,
      "text": "比如说卖出来两三个"
    },
    {
      "start": 958.49,
      "end": 988.6,
      "text": "赚钱机器"
    },
    {
      "start": 988.6,
      "end": 989.52,
      "text": "另一个是"
    },
    {
      "start": 989.52,
      "end": 991.0,
      "text": "你觉得"
    },
    {
      "start": 991.0,
      "end": 993.56,
      "text": "非常值的古票上"
    },
    {
      "start": 993.56,
      "end": 998.05,
      "text": "然后你拿出来三层的钱"
    },
    {
      "start": 998.05,
      "end": 1001.81,
      "text": "你就把这个钱流着自己挖"
    },
    {
      "start": 1001.81,
      "end": 1010.77,
      "text": "你想怎么挖你就赚钱机器"
    },
    {
      "start": 1010.77,
      "end": 1025.42,
      "text": "然后呢"
    },
    {
      "start": 1025.42,
      "end": 1026.66,
      "text": "你愿意再进来"
    },
    {
      "start": 1026.66,
      "end": 1027.58,
      "text": "再进来"
    },
    {
      "start": 1027.58,
      "end": 1032.15,
      "text": "不愿意进来"
    },
    {
      "start": 1032.15,
      "end": 1033.75,
      "text": "你也就流着"
    },
    {
      "start": 1033.75,
      "end": 1037.18,
      "text": "就挖的"
    },
    {
      "start": 1037.18,
      "end": 1038.98,
      "text": "因为本质上"
    },
    {
      "start": 1038.98,
      "end": 1040.46,
      "text": "你要是明白的古车"
    },
    {
      "start": 1040.46,
      "end": 1042.5,
      "text": "就是财富"
    },
    {
      "start": 1042.5,
      "end": 1044.22,
      "text": "事实上每个人"
    },
    {
      "start": 1044.22,
      "end": 1045.58,
      "text": "真正需要逃的钱"
    },
    {
      "start": 1045.58,
      "end": 1046.38,
      "text": "并不逻"
    },
    {
      "start": 1046.38,
      "end": 1049.04,
      "text": "要不信的话"
    },
    {
      "start": 1049.04,
      "end": 1051.76,
      "text": "你比较说你现在拿一百万"
    },
    {
      "start": 1051.76,
      "end": 1052.72,
      "text": "你要是年"
    },
    {
      "start": 1052.72,
      "end": 1068.51,
      "text": "脚棉把新来讲"
    },
    {
      "start": 1068.51,
      "end": 1070.75,
      "text": "也挺好的"
    },
    {
      "start": 1070.75,
      "end": 1072.23,
      "text": "你有什么可优于的"
    },
    {
      "start": 1072.23,
      "end": 1080.41,
      "text": "那出100万块钱的"
    },
    {
      "start": 1080.41,
      "end": 1085.61,
      "text": "现在一年赚个三层二十万"
    },
    {
      "start": 1085.61,
      "end": 1086.89,
      "text": "说汉的"
    },
    {
      "start": 1086.89,
      "end": 1088.69,
      "text": "那都是不赚钱的人"
    },
    {
      "start": 1088.69,
      "end": 1096.62,
      "text": "想想拿一百万"
    },
    {
      "start": 1096.62,
      "end": 1099.82,
      "text": "你就万一说的这种方法来逃资"
    },
    {
      "start": 1100.06,
      "end": 1100.66,
      "text": "然后呢"
    },
    {
      "start": 1100.66,
      "end": 1108.54,
      "text": "你把所有政策钱"
    },
    {
      "start": 1108.54,
      "end": 1112.28,
      "text": "要自己"
    },
    {
      "start": 1112.28,
      "end": 1113.28,
      "text": "然后呢"
    },
    {
      "start": 1113.28,
      "end": 1115.72,
      "text": "你就就这些你成了缸了"
    },
    {
      "start": 1115.72,
      "end": 1127.62,
      "text": "你就100万就缸了"
    },
    {
      "start": 1127.62,
      "end": 1129.78,
      "text": "你能撒一样"
    },
    {
      "start": 1129.78,
      "end": 1131.26,
      "text": "你不用看了来"
    },
    {
      "start": 1131.26,
      "end": 1133.5,
      "text": "也不用跑去"
    },
    {
      "start": 1133.5,
      "end": 1134.78,
      "text": "这100万块钱"
    },
    {
      "start": 1134.78,
      "end": 1138.87,
      "text": "你就把他当能了"
    },
    {
      "start": 1138.87,
      "end": 1140.67,
      "text": "着急的"
    },
    {
      "start": 1140.67,
      "end": 1141.75,
      "text": "那钱呢"
    },
    {
      "start": 1141.75,
      "end": 1143.91,
      "text": "你有没本事"
    },
    {
      "start": 1143.91,
      "end": 1147.55,
      "text": "钱也来不了"
    },
    {
      "start": 1147.55,
      "end": 1148.31,
      "text": "所以呢"
    },
    {
      "start": 1148.31,
      "end": 1150.35,
      "text": "你要是没有其他的本事"
    },
    {
      "start": 1150.39,
      "end": 1151.43,
      "text": "你有马云的本事"
    },
    {
      "start": 1151.43,
      "end": 1153.63,
      "text": "能去算马云好了"
    },
    {
      "start": 1153.63,
      "end": 1154.63,
      "text": "你要是没有马云"
    },
    {
      "start": 1154.63,
      "end": 1158.81,
      "text": "没不会做生意"
    },
    {
      "start": 1158.81,
      "end": 1170.63,
      "text": "不会不会干嘛"
    },
    {
      "start": 1170.63,
      "end": 1171.55,
      "text": "不必只要"
    },
    {
      "start": 1171.55,
      "end": 1173.75,
      "text": "言格的按照这种"
    },
    {
      "start": 1173.75,
      "end": 1189.14,
      "text": "低谋指"
    },
    {
      "start": 1189.14,
      "end": 1194.71,
      "text": "英国那些金融教授"
    },
    {
      "start": 1194.71,
      "end": 1199.51,
      "text": "给总结的"
    },
    {
      "start": 1199.51,
      "end": 1218.5,
      "text": "这100年"
    },
    {
      "start": 1218.5,
      "end": 1222.62,
      "text": "也就是说白了"
    },
    {
      "start": 1222.62,
      "end": 1223.42,
      "text": "所以请"
    },
    {
      "start": 1223.42,
      "end": 1224.42,
      "text": "自己去嘛"
    },
    {
      "start": 1224.42,
      "end": 1253.65,
      "text": "你能够百分之外"
    },
    {
      "start": 1253.65,
      "end": 1254.77,
      "text": "你最有实话"
    },
    {
      "start": 1254.77,
      "end": 1256.25,
      "text": "那说明你以前过的"
    },
    {
      "start": 1256.25,
      "end": 1259.38,
      "text": "很悲哲一"
    },
    {
      "start": 1259.38,
      "end": 1260.94,
      "text": "如果是老年"
    },
    {
      "start": 1260.94,
      "end": 1262.94,
      "text": "你最有实话块钱"
    },
    {
      "start": 1262.94,
      "end": 1264.82,
      "text": "那更说明"
    },
    {
      "start": 1264.82,
      "end": 1272.79,
      "text": "你以前"
    },
    {
      "start": 1272.79,
      "end": 1273.91,
      "text": "那想一下就是"
    },
    {
      "start": 1273.91,
      "end": 1275.95,
      "text": "即使是有实话块钱"
    },
    {
      "start": 1275.95,
      "end": 1284.82,
      "text": "你就全拿把吃完了面"
    },
    {
      "start": 1284.82,
      "end": 1288.01,
      "text": "那也说"
    },
    {
      "start": 1288.01,
      "end": 1294.66,
      "text": "那时候500并没有钱"
    },
    {
      "start": 1294.66,
      "end": 1300.75,
      "text": "你只振钱"
    },
    {
      "start": 1300.75,
      "end": 1301.47,
      "text": "不用急"
    },
    {
      "start": 1301.47,
      "end": 1302.39,
      "text": "你急的干嘛"
    },
    {
      "start": 1302.39,
      "end": 1304.23,
      "text": "你要钱干嘛"
    },
    {
      "start": 1304.23,
      "end": 1306.03,
      "text": "你现在没有钱"
    },
    {
      "start": 1306.03,
      "end": 1307.51,
      "text": "那你就好好振钱"
    },
    {
      "start": 1307.51,
      "end": 1309.07,
      "text": "生活"
    },

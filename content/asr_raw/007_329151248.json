      "end": 2585.76,
      "text": "目演"
    },
    {
      "start": 2585.76,
      "end": 2586.88,
      "text": "要得知道"
    },
    {
      "start": 2586.88,
      "end": 2587.92,
      "text": "这一个"
    },
    {
      "start": 2587.92,
      "end": 2607.37,
      "text": "一个个案例背后的那些故事"
    },
    {
      "start": 2607.37,
      "end": 2609.49,
      "text": "认识定集的上学院"
    },
    {
      "start": 2609.49,
      "end": 2614.72,
      "text": "打孩子"
    },
    {
      "start": 2614.72,
      "end": 2618.13,
      "text": "本事"
    },
    {
      "start": 2618.13,
      "end": 2628.42,
      "text": "而且东西交给他"
    },
    {
      "start": 2628.42,
      "end": 2635.74,
      "text": "他自己才能"
    },
    {
      "start": 2635.74,
      "end": 2640.99,
      "text": "一步不下情织"
    },
    {
      "start": 2640.99,
      "end": 2652.21,
      "text": "一点一点在从天"
    },
    {
      "start": 2652.21,
      "end": 2654.29,
      "text": "身上我在群里"
    },
    {
      "start": 2655.98,
      "end": 2660.17,
      "text": "把人播的"
    },
    {
      "start": 2660.17,
      "end": 2666.45,
      "text": "并不是"
    },
    {
      "start": 2666.45,
      "end": 2667.25,
      "text": "能打一样"
    },
    {
      "start": 2667.25,
      "end": 2670.85,
      "text": "打一样"
    },
    {
      "start": 2670.85,
      "end": 2672.33,
      "text": "打一样"
    },
    {
      "start": 2672.33,
      "end": 2672.85,
      "text": "不是"
    },
    {
      "start": 2672.85,
      "end": 2674.41,
      "text": "那样"
    },
    {
      "start": 2674.41,
      "end": 2676.25,
      "text": "我觉得这个"
    },
    {
      "start": 2676.25,
      "end": 2677.25,
      "text": "对一个家庭"
    },
    {
      "start": 2677.25,
      "end": 2680.46,
      "text": "对一个家族"
    },
    {
      "start": 2680.46,
      "end": 2682.14,
      "text": "所寸"
    },
    {
      "start": 2682.14,
      "end": 2688.34,
      "text": "才是自由家族的动物"
    },
    {
      "start": 2688.34,
      "end": 2691.38,
      "text": "大家说到这"
    },
    {
      "start": 2691.38,
      "end": 2692.98,
      "text": "这几天"
    },
    {
      "start": 2693.98,
      "end": 2697.02,
      "text": "过着注意样的生活"
    },
    {
      "start": 2697.02,
      "end": 2704.57,
      "text": "有的人说配修生活"
    },
    {
      "start": 2704.57,
      "end": 2705.73,
      "text": "也没什么意思"
    },
    {
      "start": 2705.73,
      "end": 2723.78,
      "text": "政府的结果"
    },
    {
      "start": 2723.78,
      "end": 2726.11,
      "text": "一行人结果"
    },
    {
      "start": 2726.11,
      "end": 2733.08,
      "text": "真到了的是"
    },
    {
      "start": 2733.08,
      "end": 2735.08,
      "text": "一节就不一样"
    },
    {
      "start": 2735.08,
      "end": 2735.88,
      "text": "就觉得一行"
    },
    {
      "start": 2735.88,
      "end": 2738.08,
      "text": "像也没什么"
    },
    {
      "start": 2738.08,
      "end": 2739.84,
      "text": "还是有一个目标"
    },
    {
      "start": 2739.92,
      "end": 2749.06,
      "text": "我的过程"
    },
    {
      "start": 2749.06,
      "end": 2750.06,
      "text": "提起"
    },
    {
      "start": 2767.7,
      "end": 2769.98,
      "text": "追求幸福的那个"
    },
    {
      "start": 2769.98,
      "end": 2790.06,
      "text": "在这个时候"
    },
    {
      "start": 2790.06,
      "end": 2791.62,
      "text": "尽量的少处门"
    },
    {
      "start": 2791.62,
      "end": 2808.86,
      "text": "定一定要"
